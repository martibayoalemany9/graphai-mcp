{
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/my-ip", "destination": "/api/my-ip" },
    { "source": "/my-ip-geolocation", "destination": "/api/my-ip-geolocation" },
    { "source": "/latency", "destination": "/api/ping" },
    { "source": "/speed", "destination": "/api/speed" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Timing-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
